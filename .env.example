# =============================================================================
# secops-squad environment variables
# =============================================================================
# Copy this file to .env and fill in your values.
# None of these are required — the framework works with .secops/ YAML config.
# These are convenience overrides for CI/CD and scripting.
# =============================================================================

# --- Azure Core ---
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=

# --- Microsoft Sentinel ---
SENTINEL_WORKSPACE_ID=
SENTINEL_WORKSPACE_NAME=
SENTINEL_RESOURCE_GROUP=

# --- Microsoft Defender for Endpoint (MDE) ---
# App registration with WindowsDefenderATP API permissions
MDE_APP_ID=
MDE_APP_SECRET=

# --- Microsoft Defender XDR ---
# Uses Microsoft Graph Security API
# App registration with SecurityEvents.Read.All, ThreatHunting.Read.All
M365_DEFENDER_APP_ID=
M365_DEFENDER_APP_SECRET=

# --- Microsoft Defender for Cloud ---
# Uses Azure Resource Manager API — no separate app registration needed
# Requires Security Reader role on the subscription
DEFENDER_CLOUD_SUBSCRIPTION_ID=

# --- Microsoft Defender for Identity ---
# Workspace name from the Defender for Identity portal
MDI_WORKSPACE_NAME=

# --- Microsoft Entra ID Protection ---
# Uses Microsoft Graph API
# App registration with IdentityRiskEvent.Read.All, IdentityRiskyUser.Read.All
ENTRA_PROTECTION_APP_ID=
ENTRA_PROTECTION_APP_SECRET=

# --- Azure Data Explorer (ADX) ---
ADX_CLUSTER_URI=
ADX_DATABASE=

# --- Okta (lib/okta — migration analysis) ---
# Required: Okta org URL (e.g. https://acme.okta.com)
OKTA_ORG_URL=
# Option A: SSWS API token (authMethod: 'ssws', default)
OKTA_API_TOKEN=
# Option B/C: OAuth2 service app (authMethod: 'clientCredentials' or 'privateKeyJwt')
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_PRIVATE_KEY=
# Space-separated scopes (default: okta.users.read okta.groups.read okta.apps.read okta.policies.read)
OKTA_SCOPES=
# Auth method: ssws | clientCredentials | privateKeyJwt (default: ssws)
OKTA_AUTH_METHOD=