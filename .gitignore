# Squad: ignore runtime state (logs, inbox, sessions)
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
.squad/.scratch/
.squad/.first-run
# Squad: SubSquad activation file (local to this machine)
.squad-workstream
# Generated by secops-squad init (user-specific config)
secops-squad.config.json
# SecOps customer environment data (discovery-log contains environment-specific facts)
# Keep .secops/ templates committed; .gitignore the discovery log that accumulates runtime data
.secops/discovery-log.yaml
# Foundry: ignore the generated deployment config (contains tenant-specific resource names).
# Ship .secops/foundry.yaml.example as the template; the deploy script writes foundry.yaml locally.
.secops/foundry.yaml
.secops/foundry-audit.jsonl
# Dependencies
node_modules/
