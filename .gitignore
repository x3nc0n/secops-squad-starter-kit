# Squad: ignore runtime state (logs, inbox, sessions)
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
.squad/.scratch/
.squad/.first-run
# Squad: SubSquad activation file (local to this machine)
.squad-workstream
# Generated by secops-squad init (user-specific config)
secops-squad.config.json

# -----------------------------------------------------------------------
# Personal state — gitignored per cli/framework-manifest.json personal_paths
# *.example files are ALWAYS tracked (framework templates) — see negation rules
# -----------------------------------------------------------------------

# SecOps live config (consumer's org-specific YAML — NOT *.example files)
.secops/**/*.yaml
!**/*.example

# Squad personal state
.squad/agents/*/history.md
.squad/agents/*/history-archive.md
.squad/decisions.md
.squad/decisions-archive.md
.squad/decisions/decisions.md
.squad/identity/now.md
.squad/identity/wisdom.md

# Root decisions log (personal)
decisions.md

# Dependencies
node_modules/
