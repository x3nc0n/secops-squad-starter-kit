# =============================================================================
# .secops/foundry.yaml — Azure AI Foundry Model Configuration (OPTIONAL)
# =============================================================================
# Generated by: scripts/deploy-foundry-fable5.ps1 (or .sh)
# Purpose: When present, secops-squad agents can route deep-analysis tasks
#          to Fable 5 for enhanced reasoning on complex security findings.
#
# DEPRECATED_WHEN: claude-fable-5 is available in the GitHub Copilot model
#   catalog. At that point, delete this file, the deploy scripts, and the
#   foundry-model-routing skill.
#
# Canonical schema (snake_case throughout, schema_version required):
# =============================================================================

schema_version: "1.0"
foundry:
  enabled: true
  resource_name: "secops-foundry"

  # Base URL ONLY — no provider path suffix.
  # The per-deployment api_path field carries the route (e.g. /anthropic/v1/messages).
  endpoint: "https://secops-foundry.cognitiveservices.azure.com"

  location: "eastus2"
  resource_group: "rg-secops-ai"

  # REST API version used for OpenAI-compatible deployments.
  # Verified stable: https://learn.microsoft.com/rest/api/cognitiveservices/
  api_version: "2025-04-01-preview"

  # Which model_deployments entry is currently active.
  active_model: "claude-fable-5"

  model_deployments:
    - model_id: "claude-fable-5"
      deployment_name: "fable5-secops"
      deployment_type: "global-standard"

      # provider drives HTTP dispatch:
      #   "anthropic"        → POST {endpoint}{api_path}  (Anthropic Messages API)
      #   "openai"           → POST {endpoint}/openai/deployments/{name}/chat/completions
      #   "openai-reasoning" → same as openai + max_completion_tokens / reasoning_effort
      provider: "anthropic"

      # "active" means this deployment is live and accepts traffic.
      # Use "inactive" or "pending_quota" to disable without removing the entry.
      status: "active"

      # Provider-specific REST path appended to the base endpoint (anthropic only).
      api_path: "/anthropic/v1/messages"

      # Set true for reasoning models (o4-mini, o3) — enables max_completion_tokens
      # and reasoning_effort parameters instead of max_tokens.
      reasoning_model: false

  pricing:
    input_per_million_tokens: 10.00
    output_per_million_tokens: 50.00
    prompt_cache_discount_pct: 90   # Anthropic prompt cache discount

  # Per-session spend guard. Agents should check before routing to Foundry.
  cost_ceiling_usd: 5.00
